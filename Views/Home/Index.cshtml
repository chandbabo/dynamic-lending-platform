@{
    ViewData["Title"] = "Dashboard";
}

<div class="row-card">
    <div class="stat-box">
        <div class="stat-label">Total Products</div>
        <div class="stat-number">12</div>
    </div>
    <div class="stat-box">
        <div class="stat-label">Total Cases</div>
        <div class="stat-number">148</div>
    </div>
    <div class="stat-box">
        <div class="stat-label">New Cases</div>
        <div class="stat-number">24</div>
    </div>
    <div class="stat-box">
        <div class="stat-label">Approved</div>
        <div class="stat-number">64</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card">
            <h4>Recent Activity</h4>
            <div class="mt-3">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">New case received</li>
                    <li class="list-group-item">Nadra verification completed</li>
                    <li class="list-group-item">Status API call succeeded</li>
                    <li class="list-group-item">Case approved for review</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <h4>Processing Summary</h4>
            <div class="mt-3">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Workflow: Personal Loan</li>
                    <li class="list-group-item">Avg processing time: 2.4 hours</li>
                    <li class="list-group-item">API health: 96%</li>
                    <li class="list-group-item">Report schedule: Daily</li>
                </ul>
            </div>
        </div>
    </div>
</div>
