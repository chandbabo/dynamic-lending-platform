<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LendingOps</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-mark">L</span>
                <span>LendingOps</span>
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index">Dashboard</a>
                <a asp-controller="Users" asp-action="Index">Users</a>
                <a asp-controller="Reports" asp-action="Index">Reports</a>
                <a asp-controller="Scheduler" asp-action="Index">Scheduler</a>
                <a asp-area="Identity" asp-page="/Account/Login">Login</a>
            </nav>
        </aside>

        <main class="main-panel">
            <header class="topbar">
                <div class="topbar-title">
                    <h2>Operations Console</h2>
                </div>
                <div class="topbar-actions">
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <div class="content-area">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
