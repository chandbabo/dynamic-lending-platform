@model LendingProcessingSystem.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="card" style="max-width:560px; margin: 50px auto; padding: 28px;">
    <h3 class="mb-4">Reset Password</h3>

    <form asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">New Password</label>
            <input asp-for="NewPassword" class="form-control" type="password" required />
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" required />
        </div>

        <button type="submit" class="btn btn-primary w-100">Reset Password</button>
    </form>
</div>
